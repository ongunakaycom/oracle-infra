# ==========================================
# Terraform & Infrastructure as Code (IaC)
# ==========================================
# Local .terraform directories (provider binaries, modules)
.terraform/
.terraform.lock.hcl

# Terraform state files (Çok kritik, asla git'e eklenmemeli)
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform variables (Hassas bilgiler içerebilir)
*.tfvars
*.tfvars.json
!.tfvars.example

# Terraform plan files
*.tfplan
generated_instance.tf

# ==========================================
# Güvenlik & Hassas Anahtarlar (Security)
# ==========================================
# SSH Private Keys (Bunlar asla GitHub'a gitmemeli)
*.pem
*.key
*.ppk
*_key
*_key.ppk
id_rsa*
oracle_key
my_deploy_key
test_key

# NOT: .pub uzantılı public key'ler güvenlidir, ancak temizlik için hariç tutulabilir.
# *.pub

# ==========================================
# Geçici Dosyalar & Diğer
# ==========================================
# Hatalı oluşturulmuş geçici dosyalar
Y

# Python scripts (varsa)
*.py
__pycache__/
*.py[cod]
*$py.class

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log